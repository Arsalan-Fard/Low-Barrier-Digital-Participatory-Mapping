.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# Ignore build files, except the checked-in Liberty style used by this
# repository's local Maputnik workspace.
public/*
!public/styles/
public/styles/*
!public/styles/liberty.json
/errorShots
/old
/cypress/screenshots
/desktop/version.go

